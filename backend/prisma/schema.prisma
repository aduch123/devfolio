generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  username           String    @unique
  passwordHash       String
  onboardingComplete Boolean   @default(false)
  shareToken         String?   @unique
  emailVerifiedAt    DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())

  profile            Profile?
  skills             Skill[]
  projects           Project[]
  socialLinks        SocialLink[]
  timelineItems      TimelineItem[]
  sessions           Session[]
  emailTokens        EmailToken[]
  onboardingDraft    OnboardingDraft?

  @@index([deletedAt])
}

model Profile {
  id            String   @id @default(uuid())
  displayName   String?
  aboutText     String?
  heroRoleTexts String[]
  contactEmail  String?
  contactPhone  String?
  githubUrl     String?
  headline      String?
  location      String?
  avatarUrl     String?
  resumeUrl     String?
  // Per-section { visible, order }; validated in Phase 2.5. null = defaults.
  sectionConfig Json?

  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id       String  @id @default(uuid())
  name     String
  icon     String?
  level    String
  category String   @default("other")
  iconKey  String?
  isCustom Boolean  @default(false)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  repoUrl     String?
  liveUrl     String?
  tags        String[]
  coverImageUrl String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

model SocialLink {
  id        String   @id @default(uuid())
  platform  String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

enum TimelineType {
  EXPERIENCE
  EDUCATION
}

model TimelineItem {
  id           String       @id @default(uuid())
  type         TimelineType
  title        String
  organization String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, sortOrder])
}

model Session {
  id              String    @id @default(uuid())
  refreshHash     String
  prevRefreshHash String?
  rotatedAt       DateTime?
  expiresAt       DateTime
  revokedAt       DateTime?
  userAgent       String?
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum EmailTokenType {
  VERIFY_EMAIL
  PASSWORD_RESET
}

// Single-use tokens sent by email. Only the sha256 of the token is stored.
// Used by email verification (1.4) and password reset (1.5).
model EmailToken {
  id        String         @id @default(uuid())
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// Wizard progress (Phase 3): one row per user. `data` holds each saved step under its number ("1" to "5"),
// `skipped` lists the steps the user skipped, `step` is where to resume (1 to 6, 6 = review).
// After completing, `data` is emptied and `skipped` is kept so the dashboard can list what is missing.
model OnboardingDraft {
  id        String   @id @default(uuid())
  step      Int      @default(1)
  data      Json     @default("{}")
  skipped   Int[]
  updatedAt DateTime @updatedAt

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
