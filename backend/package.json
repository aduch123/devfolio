    "format": "cd .. && prettier --config backend/.prettierrc --ignore-path backend/.prettierignore --write backend frontend",
    "format:check": "cd .. && prettier --config backend/.prettierrc --ignore-path backend/.prettierignore --check backend frontend",
    "smoke": "node scripts/smoke.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
