{
  "name": "devfolio",
  "version": "1.0.0",
  "description": "Devfolio: developer portfolio platform (API and static frontend)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "cd .. && eslint -c backend/eslint.config.js backend frontend",
