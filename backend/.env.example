# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/devfolio

# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string

# Resend API key for contact-form emails (https://resend.com)
RESEND_API_KEY=re_replace_me

# Sender shown on contact emails (optional). The default is Resend's test sender, which only
# delivers to your own Resend account email until you verify a domain.
RESEND_FROM=Devfolio <onboarding@resend.dev>

# Separate database used only by `npm test` (never your dev database). Create it, then run
# DATABASE_URL=<this url> npx prisma migrate deploy
# DATABASE_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/devfolio_test

# Public address of the site, used for links in emails (optional, default http://localhost:PORT).
# APP_URL=https://devfolio.example

# Number of reverse proxies in front of the app (optional, default false = none).
# Set to 1 when deployed behind one proxy (Render, Railway, nginx...), so rate limits see real IPs.
TRUST_PROXY=false

# Comma-separated origins allowed to call the API from another site (optional, default: none).
# CORS_ORIGINS=https://example.com
