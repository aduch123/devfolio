# Copy to root .env.production, restrict permissions to 600, and never commit it.
POSTGRES_PASSWORD=replace_with_a_long_random_hex_password
DATABASE_URL=postgresql://devfolio:replace_with_same_hex_password@db:5432/devfolio
JWT_SECRET=replace_with_at_least_32_random_characters
RESEND_API_KEY=re_replace_me
RESEND_FROM=Devfolio <noreply@your-verified-domain.example>
APP_DOMAIN=portfolio.yourdomain.example
APP_URL=https://portfolio.yourdomain.example
TRUST_PROXY=1
NODE_ENV=production
PORT=5000
UPLOAD_DIR=/data/uploads
LOG_LEVEL=info
# ERROR_WEBHOOK_URL=https://your-monitor.example/hooks/devfolio
